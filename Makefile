# ==============================================================================
# Makefile для сборки и демонстрации взаимодействия NASM и C
# ==============================================================================

CC = gcc
CFLAGS = -Wall -Wextra -O2 -std=c11

NASM = nasm
NASMFLAGS = -f elf64 -g
LD = ld

all: app_nasm app_c

# Сборка ассемблерной программы (NASM -> ELF64 объектный файл -> компоновка ld)
app_nasm: app_nasm.o
	$(LD) app_nasm.o -o app_nasm

app_nasm.o: app_nasm.asm
	$(NASM) $(NASMFLAGS) app_nasm.asm -o app_nasm.o

# Сборка программы на C
app_c: app_c.c
	$(CC) $(CFLAGS) app_c.c -o app_c

# Демонстрационный полный запуск взаимодействия
run: all
	@echo "======================================================================"
	@echo "ШАГ 1: Запуск программы на NASM (генерация исходных бинарных данных)"
	@echo "======================================================================"
	./app_nasm
	@echo "======================================================================"
	@echo "ШАГ 2: Запуск программы на C (чтение, трансформация и бинарный ответ)"
	@echo "======================================================================"
	./app_c
	@echo "======================================================================"
	@echo "ШАГ 3: Повторный запуск NASM (верификация ответа от C и финальный отчет)"
	@echo "======================================================================"
	./app_nasm
	@echo "======================================================================"
	@echo "ШАГ 4: Просмотр созданных двоичных файлов в каталоге bin_exchange/"
	@echo "======================================================================"
	ls -lh bin_exchange/
	@echo ""
	@echo "--- Дамп asm_to_c.bin (сгенерирован NASM) ---"
	hexdump -C bin_exchange/asm_to_c.bin
	@echo ""
	@echo "--- Дамп c_to_asm.bin (ответ от C) ---"
	hexdump -C bin_exchange/c_to_asm.bin
	@echo ""
	@echo "--- Дамп final_report.bin (финальный отчет NASM) ---"
	hexdump -C bin_exchange/final_report.bin

# Очистка скомпилированных файлов и каталога обмена
clean:
	rm -rf app_nasm app_nasm.o app_c bin_exchange

.PHONY: all run clean
